@online{yangMultiphysicsBenchBenchmarking2025,
  title = {Multiphysics {{Bench}}: {{Benchmarking}} and {{Investigating Scientific Machine Learning}} for {{Multiphysics PDEs}}},
  shorttitle = {Multiphysics {{Bench}}},
  author = {Yang, Changfan and Bai, Lichen and Wang, Yinpeng and Zhang, Shufei and Xie, Zeke},
